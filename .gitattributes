# ===================== LINE ENDINGS, FIRST BECAUSE LAST-MATCH-WINS =====================
#
# text=auto normalises to LF in the repository and checks out CRLF on Windows.
# This sits at the TOP on purpose: in .gitattributes the LAST matching rule
# wins, so putting it below the LFS block would override every `-text` there and
# start mangling binary assets.
#
# Why it is here at all: TUCoasterRide.cpp had ended up with mixed CRLF and LF
# regions, and a search for a statement ending in `);
` walked straight past a
# CRLF-terminated one into the next block -- which put a line outside the `if`
# it belonged to. It compiled, it looked right, and it reported a check as
# failed that had passed. A file with two kinds of line ending is a file where
# text tools quietly disagree about where statements end.
* text=auto

# Git LFS tracking for Unreal Engine binary assets.
# Run `git lfs install` once, then these are tracked automatically on add/commit.

*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# HDRIs are the ones that bite — 20-100 MB each and permanent once in history.
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.dds filter=lfs diff=lfs merge=lfs -text
# Splash screens and the packaged-app icon. A 720x370 BMP is uncompressed and
# near a megabyte, which is exactly what LFS is for.
*.bmp filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text

# Keep text-based project/config/source files as normal diffable text.
*.uproject text
*.ini text
*.h text
*.cpp text
*.cs text
*.md text
